# Configuración del entorno - BSale ↔ Amazon Sync
# Copia este archivo a .env y llena tus credenciales

# ============================================
# SERVIDOR
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# BSALE API
# ============================================
# Obtener en: https://api.bsale.io/
# Documentación: https://github.com/bsaleio/documentacion
BSALE_API_TOKEN=tu_token_aqui
BSALE_BASE_URL=https://api.bsale.io/v1

# ID de la oficina/sucursal en BSale (2 = sucursal principal)
BSALE_OFFICE_ID=2

# ============================================
# AMAZON SP-API (Selling Partner API)
# ============================================
# IMPORTANTE: Desde octubre 2023, Amazon SP-API ya NO requiere AWS IAM.
# Solo necesitas las credenciales de Login with Amazon (LWA).
#
# Pasos para obtener:
# 1. Ve a https://sellercentral.amazon.com (o .mx para México)
# 2. Settings → User Permissions → Authorize a Developer
# 3. Registra tu app en Seller Central (obtendrás Client ID y Secret)
# 4. Autoriza la app para obtener el Refresh Token

# Login with Amazon (LWA) - OAuth 2.0
AMAZON_LWA_CLIENT_ID=tu_client_id_aqui
AMAZON_LWA_CLIENT_SECRET=tu_client_secret_aqui
AMAZON_REFRESH_TOKEN=tu_refresh_token_aqui

# Marketplace ID (depende del país)
# MX: A1AM78C64UM0Y8 (Amazon.com.mx)
# US: ATVPDKIKX0DER (Amazon.com)
# BR: A2Q3Y263D00KWC (Amazon.com.br)
AMAZON_MARKETPLACE_ID=A1AM78C64UM0Y8

# (Opcional) Seller ID de Amazon — se usa en los XML feeds
# Lo encuentras en Seller Central → Settings → Account Info → Merchant Token
AMAZON_SELLER_ID=

# ============================================
# MAPEO SKU
# ============================================
# Formato: SKU_BSALE=SKU_AMAZON (uno por línea, o usar API de mapeo)
# Ejemplo:
# SKU_BSALE_001=AMZ-SKU-001
# SKU_BSALE_002=AMZ-SKU-002

# ============================================
# SYNC CONFIG
# ============================================
# Intervalo de sincronización automática (en minutos, 0 = desactivado)
SYNC_INTERVAL_MINUTES=30

# Umbral de stock mínimo para considerar "sin stock"
STOCK_THRESHOLD=0
